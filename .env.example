# Sao chep thanh .env (da .gitignore) va dien gia tri that. KHONG commit .env.
# Day du bien moi truong: specs/001-auth-rbac/spec.md §0.3.

# DB — Neon: lay host o Dashboard > Connect, tat "Connection pooling" (host khong co -pooler)
DB_URL=jdbc:postgresql://<host>/cnhsk_db?sslmode=require
# Chạy PostgreSQL local bằng docker compose: DB_URL=jdbc:postgresql://localhost:5432/cnhsk_db (không cần sslmode)
DB_USER=svc_app
DB_PASSWORD=
# CHI LEADER: Flyway chay bang tai khoan owner (tao/sua bang). Thanh vien bo trong 2 dong nay.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# Bootstrap admin (tùy chọn)
CNHSK_BOOTSTRAP_ADMIN_EMAIL=
CNHSK_BOOTSTRAP_ADMIN_PASSWORD=

# JWT — sinh secret ngẫu nhiên tối thiểu 32 byte (64 ký tự hex).
JWT_SECRET=

# Cookie và URL frontend local
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
APP_WEB_BASE_URL=http://localhost:5173

# Redis local Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit mặc định cho phát triển local và test; không cần tài khoản hoặc TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# Gmail SMTP thay thế (bỏ comment các dòng bên dưới và điền thông tin của bạn).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# SMTP_PASSWORD là App Password Gmail 16 ký tự; MAIL_FROM cần trùng SMTP_USER.

# Chỉ dùng khi chạy PostgreSQL local bằng docker compose; nhóm dùng Neon thì để trống.
POSTGRES_PASSWORD=
